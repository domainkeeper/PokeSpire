{
  "name": "poke-spire",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "data:sync": "node scripts/poke-data-sync.mjs",
    "data:sync:force": "node scripts/poke-data-sync.mjs --force",
    "data:validate": "node scripts/poke-validate.mjs",
    "data:sprites": "node scripts/poke-data-sync.mjs --sprites-only",
    "data:animate": "node scripts/poke-extract-frames.mjs",
    "data:animate:force": "node scripts/poke-extract-frames.mjs --force",
    "vfx:sheets": "node scripts/vfx-generate-sheets.mjs"
  },
  "dependencies": {
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "gifuct-js": "^2.1.2",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
